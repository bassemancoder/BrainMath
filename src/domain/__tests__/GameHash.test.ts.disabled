/**
 * Tests for GameHash entity
 */

import { describe, it, expect } from 'vitest';
import {
  isValidHash,
  parseHash,
  encodeHash,
  generateSeed,
  generateHash,
  getGridSizeLabel,
  getDifficultyLabel,
} from '../entities/GameHash';

describe('GameHash', () => {
  describe('isValidHash', () => {
    it('returns true for valid hash format', () => {
      expect(isValidHash('52A7X2')).toBe(true);
      expect(isValidHash('31ABCD')).toBe(true);
      expect(isValidHash('73ZZZZ')).toBe(true);
      expect(isValidHash('410000')).toBe(true);
    });

    it('returns true for lowercase (case insensitive)', () => {
      expect(isValidHash('52a7x2')).toBe(true);
      expect(isValidHash('31abcd')).toBe(true);
    });

    it('returns false for wrong length', () => {
      expect(isValidHash('52A7X')).toBe(false);
      expect(isValidHash('52A7X22')).toBe(false);
      expect(isValidHash('')).toBe(false);
    });

    it('returns false for invalid grid size', () => {
      expect(isValidHash('12A7X2')).toBe(false); // size 1 invalid
      expect(isValidHash('22A7X2')).toBe(false); // size 2 invalid
      expect(isValidHash('82A7X2')).toBe(false); // size 8 invalid
    });

    it('returns false for invalid difficulty', () => {
      expect(isValidHash('50A7X2')).toBe(false); // difficulty 0 invalid
      expect(isValidHash('54A7X2')).toBe(false); // difficulty 4 invalid
    });

    it('returns false for invalid seed characters', () => {
      expect(isValidHash('52A7X!')).toBe(false);
      expect(isValidHash('52A7X ')).toBe(false);
      expect(isValidHash('52a7x_')).toBe(false);
    });
  });

  describe('parseHash', () => {
    it('correctly parses valid hash', () => {
      const result = parseHash('52A7X2');
      expect(result).toEqual({
        size: 5,
        difficulty: 2,
        seed: 'A7X2',
      });
    });

    it('handles different sizes and difficulties', () => {
      expect(parseHash('31ABCD')).toEqual({
        size: 3,
        difficulty: 1,
        seed: 'ABCD',
      });
      
      expect(parseHash('73ZZZZ')).toEqual({
        size: 7,
        difficulty: 3,
        seed: 'ZZZZ',
      });
    });

    it('normalizes lowercase to uppercase', () => {
      const result = parseHash('52a7x2');
      expect(result.seed).toBe('A7X2');
    });

    it('throws on invalid hash', () => {
      expect(() => parseHash('invalid')).toThrow();
      expect(() => parseHash('12ABCD')).toThrow(); // invalid size
    });
  });

  describe('encodeHash', () => {
    it('correctly encodes components', () => {
      expect(encodeHash(5, 2, 'A7X2')).toBe('52A7X2');
      expect(encodeHash(3, 1, 'ABCD')).toBe('31ABCD');
    });

    it('normalizes seed to uppercase', () => {
      expect(encodeHash(5, 2, 'a7x2')).toBe('52A7X2');
    });

    it('throws on invalid size', () => {
      expect(() => encodeHash(1 as any, 2, 'ABCD')).toThrow();
      expect(() => encodeHash(8 as any, 2, 'ABCD')).toThrow();
    });

    it('throws on invalid difficulty', () => {
      expect(() => encodeHash(5, 0 as any, 'ABCD')).toThrow();
      expect(() => encodeHash(5, 4 as any, 'ABCD')).toThrow();
    });

    it('throws on invalid seed length', () => {
      expect(() => encodeHash(5, 2, 'ABC')).toThrow();
      expect(() => encodeHash(5, 2, 'ABCDE')).toThrow();
    });
  });

  describe('generateSeed', () => {
    it('generates 4-character seed', () => {
      const mockRandom = () => 0.5;
      const seed = generateSeed(mockRandom);
      expect(seed).toHaveLength(4);
    });

    it('uses only valid characters', () => {
      const validChars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      let index = 0;
      const mockRandom = () => (index++ % 36) / 36;
      
      const seed = generateSeed(mockRandom);
      for (const char of seed) {
        expect(validChars).toContain(char);
      }
    });
  });

  describe('generateHash', () => {
    it('generates valid hash', () => {
      const mockRandom = () => 0.5;
      const hash = generateHash(5, 2, mockRandom);
      
      expect(hash).toHaveLength(6);
      expect(isValidHash(hash)).toBe(true);
      
      const parsed = parseHash(hash);
      expect(parsed.size).toBe(5);
      expect(parsed.difficulty).toBe(2);
    });
  });

  describe('label functions', () => {
    it('returns correct grid size labels', () => {
      expect(getGridSizeLabel(3)).toBe('3×3 (Beginner)');
      expect(getGridSizeLabel(5)).toBe('5×5 (Medium)');
      expect(getGridSizeLabel(7)).toBe('7×7 (Expert)');
    });

    it('returns correct difficulty labels', () => {
      expect(getDifficultyLabel(1)).toBe('Easy (+, −)');
      expect(getDifficultyLabel(2)).toBe('Medium (+, −, ×)');
      expect(getDifficultyLabel(3)).toBe('Hard (+, −, ×, ÷)');
    });
  });
});
